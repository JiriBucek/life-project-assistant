// Ellie — Life Project Assistant
// Hierarchy: LifeArea -> Value -> Project -> Initiative -> Task, plus Reflection.
//
// Multi-user: LifeArea and Project are the only roots, so they carry the owner.
// Everything below them (Value, Initiative, Task, Reflection, SatisfactionEntry)
// inherits ownership through its parent and is reached only via that parent —
// see src/lib/scope.ts, which puts the ownership test in the query itself.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A person with their own life map. Created by hand for now
// (`npm run user:add`); passwordHash and googleId are both optional so a
// future Google sign-in can create — or claim — an account without a password.
model User {
  id           String     @id @default(cuid())
  email        String     @unique // always stored lower-cased (see normalizeEmail)
  name         String     @default("")
  passwordHash String? // null for a user who only ever signs in with Google
  googleId     String?    @unique // reserved for Google sign-in
  sessions     Session[]
  areas        LifeArea[]
  projects     Project[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// A signed-in browser. Only the SHA-256 of the cookie token is stored, so a
// leaked database still can't be used to impersonate anyone.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model LifeArea {
  id                  String              @id @default(cuid())
  name                String
  satisfaction        Int                 @default(5) // 1–10
  // The owner. Optional at the database level only so the existing
  // single-user data could gain the column without being dropped; the app
  // always sets it, and `npm run db:backfill` claims any legacy rows. Once
  // production is confirmed backfilled this can become required.
  owner               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String?
  // Position on the Life Map canvas (React Flow coords)
  x                   Float               @default(0)
  y                   Float               @default(0)
  order               Int                 @default(0)
  values              Value[]
  // Dated diary of every satisfaction rating — powers "How it's changed".
  satisfactionHistory SatisfactionEntry[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([userId])
}

// One dated satisfaction rating for a life area. Written automatically each
// time the user sets the score, so change over time can be charted.
model SatisfactionEntry {
  id        String   @id @default(cuid())
  area      LifeArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  areaId    String
  value     Int // 1–10, as rated at that moment
  createdAt DateTime @default(now())
}

model Value {
  id        String    @id @default(cuid())
  name      String
  area      LifeArea  @relation(fields: [areaId], references: [id], onDelete: Cascade)
  areaId    String
  // A Value can power many Projects; a Project can serve many Values.
  projects  Project[] @relation("ProjectValues")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id           String       @id @default(cuid())
  name         String
  whyStatement String       @default("") // the "Why" / value statement (required in UI)
  // The owner — see the note on LifeArea.userId.
  owner        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String?
  // The project's timeframe — the journey from where it begins to the
  // outcome the user currently intends. The Target is an intention, not a
  // deadline; changing it is normal adaptation, never a failure.
  startDate    DateTime     @default(now())
  targetDate   DateTime     @default(now()) // Target Completion Date (always after startDate in practice)
  // The harvest — the closing moment after every task is complete, when the
  // tool asks what the journey gave back. Null = not yet harvested; the
  // journey page offers the ritual while it stays null.
  harvestedAt    DateTime?
  harvestBrought Boolean? // the user's answer: did it bring some of it into your life?
  values       Value[]      @relation("ProjectValues")
  initiatives  Initiative[]
  reflections  Reflection[]
  // Position on the Life Map canvas
  x            Float        @default(0)
  y            Float        @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId])
}

model Initiative {
  id        String   @id @default(cuid())
  title     String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  // Timeline placement, measured in days from the project's Start Date.
  // The initiative's real Start Date = project.startDate + startDay days;
  // its End Date = that + duration days. Kept relative so the whole journey
  // reschedules cleanly when the project's Start Date moves.
  startDay  Int      @default(0)
  duration  Int      @default(14) // length in days (resizable)
  lane      Int      @default(0) // vertical row on the timeline
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id           String     @id @default(cuid())
  title        String
  isComplete   Boolean    @default(false)
  // When the task was (last) marked complete — powers the per-area Progress
  // chart. Cleared if the task is reopened.
  completedAt  DateTime?
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId String
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Reflection {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  whatChanged String
  why         String
  nextStep    String
  createdAt   DateTime @default(now())
}
